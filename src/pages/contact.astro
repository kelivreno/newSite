---
import { Button } from "@/components/ui/button"
import { Section } from "@/components/ui/section"
import { TypographyH1, TypographyP } from "@/components/ui/typography"
import { site } from "@/data/site"
import Layout from "@/layouts/Layout.astro"
---

<Layout title="Contact · Kelangit">
  <Section>
    <TypographyH1>Contact</TypographyH1>
    <TypographyP>These links are editable placeholders.</TypographyP>
    <div class="hero-links">
      <Button as="a" href={site.links.email}>EMAIL@example.com</Button>
      <Button as="a" href={site.links.github} variant="outline">GitHub</Button>
    </div>
  </Section>
</Layout>
